{
  "name": "tanstack_start_ts",
  "version": "1.0.0",
  "description": "اطلس شرکت‌های پارک فاوا",
  "author": "FAVA Park",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:cloudflare": "NITRO_PRESET=cloudflare-module vite build",
    "start": "node server/cluster.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:i18n": "bun run scripts/lint-i18n.ts",
    "test:product-routing": "python3 scripts/test-product-routing.py",
    "test:visual": "python3 scripts/test-visual-regression.py",
    "test:api": "python3 scripts/test-api-contracts.py",
    "test:unit": "vitest run tests/unit",
    "test:request-id": "python3 scripts/test-request-id-e2e.py",
    "test:directions": "python3 scripts/test-directions-e2e.py",
    "test:company-smoke": "python3 scripts/test-company-smoke.py",
    "seed": "bun run scripts/seed-dev-data.ts",
    "reset:dev": "bun run scripts/reset-dev-data.ts",
    "db:migrate": "bun run db/migrate.ts",
    "provision:company-owners": "bun run scripts/provision-company-owners.ts",
    "format": "prettier --write .",
    "offline:seed": "bun run scripts/build-offline-seed.ts",
    "electron:dev": "electron .",
    "electron:build": "vite build && node scripts/electron-vendor-deps.mjs && electron-builder --win nsis"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.50",
    "@tanstack/router-plugin": "^1.167.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "embedded-postgres": "17.10.0-beta.17",
    "framer-motion": "^12.43.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "input-otp": "^1.4.2",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "libarchive.js": "^2.0.2",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.575.0",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-i18next": "^17.0.9",
    "react-multi-date-picker": "^4.5.2",
    "react-resizable-panels": "^4.6.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-tanstack-config": "2.7.7",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "run.liara.favapark.offline",
    "productName": "FAVA Park Atlas Offline",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/main.cjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      { "from": "electron/vendor/node_modules", "to": "node_modules" },
      { "from": ".output", "to": ".output" },
      { "from": "electron/seed", "to": "electron/seed" },
      { "from": "db/migrations", "to": "db/migrations" }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "trustedDependencies": [
    "@embedded-postgres/windows-x64"
  ]
}
