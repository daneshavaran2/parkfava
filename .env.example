# Self-hosted Postgres connection. Required. See "Environment Variables" in
# README.md. Add ?sslmode=require for a managed/remote Postgres instance.
DATABASE_URL=postgres://parkfava:devpassword@localhost:5432/parkfava_dev

# Where uploaded files (logos, gallery images, attachments) are written and
# served from. On Liara this MUST be a mounted persistent disk, or uploads
# vanish on every redeploy. Defaults to ./data/uploads if unset.
UPLOAD_DIR=./data/uploads
# Read-only fallback for images baked into the container image. Leave unset:
# ./seed-assets (container) and ./scripts/atlas-images (checkout) are both
# probed automatically.
# SEED_ASSET_DIR=

# --- Optional: SMS two-step verification (off by default) ---
# MFA_ENFORCED=true
# SMS_PROVIDER=kavenegar
# SMS_API_KEY=
# SMS_SENDER_LINE=

# --- Optional: Google Maps on the company map component ---
# VITE_GOOGLE_MAPS_DEV_KEY=

# --- Optional: AI-powered smart assistant (off falls back to a "not configured" message) ---
# https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Legacy Supabase vars ---
# No longer read by the app (data, auth, and file storage are all
# self-hosted now — see the "Migration note" in README.md). Safe to remove
# once you've confirmed nothing in your deployment still references them.
