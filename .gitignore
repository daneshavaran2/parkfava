# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Local secrets — never commit real DATABASE_URL / API keys
.env
.env.local

# Bulk-provisioning credential handouts — plaintext initial passwords, never commit
scripts/output/

# Local upload storage (UPLOAD_DIR default). In production this is a mounted
# disk; locally it fills with uploaded logos/catalogs that must not be committed.
data/

# Offline Windows build: generated seed content (scripts/build-offline-seed.ts's
# output, bundled into the installer via extraResources), the vendored
# node_modules subset for packaging (scripts/electron-vendor-deps.mjs's
# output), and electron-builder's packaged output — all build artifacts, not
# source.
electron/seed/
electron/vendor/
release/

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
